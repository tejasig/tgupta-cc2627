! this is a simple fortran program to print "Hello world"
PROGRAM helloworld
! PROGRAM marks the beginning of the program and helloworld is the name given to this program.
  PRINT *, "Hello world"
  ! PRINT is used to display output on the screen.
  ! The * indicates that Fortran uses the default output format.
  ! "Hello world" is the text that will be displayed.
END PROGRAM helloworld
! END PROGRAM marks the end of the program helloworld.
